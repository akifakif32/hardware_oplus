# Battery Health
r_dir_file(system_app, vendor_sysfs_usb_supply)

# LTPO Settings
rw_dir_file(system_app, vendor_sysfs_graphics)

# Gamespace
r_dir_file(system_app, vendor_sysfs_sde_crtc)

hal_client_domain(system_app, hal_health)
hal_client_domain(system_app, hal_memtrack)
hal_client_domain(system_app, hal_power)

# Touchpanel
rw_dir_file(system_app, vendor_proc_display)

# USB fast charge
rw_dir_file(system_app, vendor_sysfs_fastcharge)

# Vibrator
rw_dir_file(system_app, sysfs_vibrator)

# Zram
r_dir_file(system_app, sysfs_zram)

# DeviceSettings: USB2 fast-charge toggle writes the oplus_chg module's
# own force_fast_charge/ffc_val module_params directly (see
# drivers/power/oplus_chg/oplus_charger.c); these are generically labeled
# sysfs by default with no dedicated type, unlike the vibrator node above.
allow system_app vendor_sysfs_oplus_chg_params:dir r_dir_perms;
allow system_app vendor_sysfs_oplus_chg_params:file rw_file_perms;
# DeviceSettings: motion smoothing sends irisConfigureSet() to the Pixelworks
# IIris HIDL service, hosted by the iris-service in hal_graphics_composer_default
# Only the client attribute: hal_client_domain() would also make system_app a
# hal_graphics_composer in the recovery (non-Treble) policy, and that
# attribute is allowed self:capability sys_nice, which no app domain may have.
typeattribute system_app hal_graphics_composer_client;
